# Appwrite (Project Settings, and Overview -> your API key)
# Endpoint is REGION-SPECIFIC on Appwrite Cloud — copy it exactly from your
# project's Settings page, e.g. https://nyc.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=research
APPWRITE_ARTICLES_COLLECTION_ID=articles
APPWRITE_SUBSCRIBERS_COLLECTION_ID=subscribers

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Slack app (api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Shared secret used to authorize the cron route.
# Generate one, e.g.: openssl rand -hex 32
CRON_SECRET=
