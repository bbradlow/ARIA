# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# In production, set these in Vercel → Project → Settings → Environment Variables.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# A long random string you invent. Put the SAME value here and on the end of
# the Postmark inbound webhook URL as ?token=THIS_VALUE
POSTMARK_WEBHOOK_TOKEN=

# Embeddings for the research Q&A feature (Voyage voyage-finance-2).
VOYAGE_API_KEY=

# A long random string you invent — guards the /api/ingest admin endpoint.
INGEST_TOKEN=

# OPTIONAL — leave unset to use the built-in defaults.
# Override the summary instructions / model without editing code:
SUMMARY_SYSTEM_PROMPT=
SUMMARY_MODEL=
# Override the model used to answer questions:
QA_MODEL=

# Guards the metrics dashboard (/dashboard and /api/metrics). Optional — if
# unset, the INGEST_TOKEN above is used instead.
METRICS_TOKEN=
