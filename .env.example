# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# In production, set these in Vercel → Project → Settings → Environment Variables.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# A long random string you invent. Put the SAME value here and on the end of
# the Postmark inbound webhook URL as ?token=THIS_VALUE
POSTMARK_WEBHOOK_TOKEN=
